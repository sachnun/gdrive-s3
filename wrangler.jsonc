{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "gdrive-s3",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "account_id": "6e1f4d1b132725bb434cad679004ccb3",
  "kv_namespaces": [
    {
      "binding": "AUTH_KV",
      "id": "20d3356495224a658e481b8d8ff407b5"
    },
    {
      "binding": "FOLDER_CACHE",
      "id": "1fc672eb19da4028b2ef35dcb2bf273a"
    }
  ],
  "vars": {
    "REGION": "us-east-1",
    "ALLOWED_BUCKETS": "my-bucket",
    "PUBLIC_READ_BUCKETS": ""
  }
